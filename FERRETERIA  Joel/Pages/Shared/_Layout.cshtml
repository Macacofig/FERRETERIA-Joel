<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ferretería Joel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/FERRETERIA__Joel.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        string activo = (string?)ViewData["ActiveMenu"] ?? "";
    }

    <header class="fj-header">
        <div class="fj-header-inner">

            <a class="fj-brand" asp-page="/Index" aria-label="Ir al inicio">
                <span class="fj-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
                </span>
                <span class="fj-brand-name">FERRETERÍA <strong>JOEL</strong></span>
            </a>

            <nav class="fj-nav" id="fjNav" aria-label="Navegación principal">
                <ul class="fj-menu">

                    @if (activo == "Home")
                    {
                        <li class="fj-menu-item is-active">
                            <a class="fj-menu-link" asp-page="/Index" aria-current="page">Home</a>
                        </li>
                    }
                    else
                    {
                        <li class="fj-menu-item">
                            <a class="fj-menu-link" asp-page="/Index">Home</a>
                        </li>
                    }

                    <li class="fj-menu-item">
                        <!-- Toggle del menú de opciones -->
                        <button id="menuOpcionesToggle" class="fj-menu-link mm-toggle" aria-haspopup="true" aria-expanded="false" type="button">
                            <span class="mm-toggle-label">Menú de opciones</span>
                            <svg class="mm-toggle-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18" /></svg>
                        </button>

                        <!-- Panel: el contenido se genera por JS a partir de menuData -->
                        <section id="menuOpciones" class="mm-panel" role="dialog" aria-label="Menú de opciones" aria-hidden="true" hidden>
                            <div class="mm-panel-inner">
                                <div id="mmGrid" class="mm-grid" role="menu" aria-orientation="vertical" tabindex="-1"></div>
                            </div>
                        </section>
                    </li>
                </ul>

                <div class="fj-nav-side">
                    <button class="fj-icon-btn" type="button" aria-label="Notificaciones">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                        <span class="fj-dot" aria-hidden="true"></span>
                    </button>
                    <button class="fj-icon-btn" type="button" aria-label="Configuración">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2v-1a2 2 0 0 1 2-2h.09c.7 0 1.25-.45 1.51-1a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06c.45.45 1.1.6 1.7.36.5-.2 1.05-.3 1.61-.3H9c.55 0 1.09.1 1.61.3.59.24 1.25.09 1.7-.36l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06c-.45.45-.6 1.1-.36 1.7.2.5.3 1.05.3 1.61V9c0 .55.1 1.09.3 1.61.24.59.09 1.25-.36 1.7l-.06.06a2 2 0 0 1 0 2.83z" /></svg>
                    </button>
                    <a class="fj-userchip" href="#" aria-label="Perfil de usuario">
                        <span class="fj-userchip-avatar" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        </span>
                        <span class="fj-userchip-name">Admin</span>
                    </a>
                </div>
            </nav>

            <button class="fj-burger" type="button" data-fj-burger aria-label="Abrir menú" aria-expanded="false" aria-controls="fjNav">
                <span class="fj-burger-line"></span>
                <span class="fj-burger-line"></span>
                <span class="fj-burger-line"></span>
            </button>
        </div>
    </header>

    <main class="fj-main">
        @RenderBody()
    </main>

    <footer class="fj-footer">
        <div class="fj-footer-shell">
            <div class="fj-footer-col fj-footer-brandblk">
                <div class="fj-footer-brand">
                    <span class="fj-brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
                    </span>
                    <span class="fj-brand-name">FERRETERÍA <strong>JOEL</strong></span>
                </div>
                <p class="fj-footer-tag">Herramientas y materiales de construcción para cada proyecto.</p>
            </div>

            <div class="fj-footer-col">
                <p class="fj-footer-title">Navegación</p>
                <ul class="fj-footer-list">
                    <li><a asp-page="/Index">Inicio</a></li>
                    <li><a asp-page="/Productos">Productos</a></li>
                    <li><a asp-page="/Categorias">Categorías</a></li>
                    <li><a asp-page="/Proveedores">Proveedores</a></li>
                    <li><span>Inventario</span></li>
                </ul>
            </div>

            <div class="fj-footer-col">
                <p class="fj-footer-title">Contacto</p>
                <ul class="fj-footer-list fj-footer-list-contact">
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                        Av. Central N.º 123, El Alto · La Paz
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                        +591 2 123 4567
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                        contacto@ferreteriajoel.com
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                        Lun – Sáb · 8:00 – 19:00
                    </li>
                </ul>
            </div>

            <div class="fj-footer-col">
                <p class="fj-footer-title">La empresa</p>
                <ul class="fj-footer-list">
                    <li><span>Sobre nosotros</span></li>
                    <li><span>Descuentos por mayor</span></li>
                    <li><span>Política de devoluciones</span></li>
                    <li><span>Trabaja con nosotros</span></li>
                </ul>
            </div>
        </div>
        <div class="fj-footer-bottom">
            <span>© 2026 Ferretería Joel. Todos los derechos reservados.</span>
            <span>Sistema administrativo · Sprint 1</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        /* Generador del menú a partir de un array de datos (Razor Pages + Vanilla JS)
           Tecnología: Razor Pages (HTML/CSS) + JavaScript simple
           Requisitos: el array menuData contiene grupos y opciones con { label, icon, route, enabled }
        */
        (function () {
            // Datos del menú (grupo > opciones). Cambiar enabled a true cuando el módulo esté listo.
            const menuData = [
                {
                    title: 'GESTIÓN DE PRODUCTOS', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M3 7h18v13H3z"/></svg>',
                    items: [
                        { label: 'Productos', route: '/Productos', enabled: true },
                        { label: 'Categorías', route: '/Categorias', enabled: true },
                        { label: 'Imágenes de productos', route: '#', enabled: false },
                        { label: 'Unidades de venta', route: '#', enabled: false },
                        { label: 'Precios y ofertas', route: '#', enabled: false }
                    ]
                },
                {
                    title: 'GESTIÓN DE INVENTARIO', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M3 7h18v10H3z"/></svg>',
                    items: [
                        { label: 'Proveedores', route: '/Proveedores', enabled: true },
                        { label: 'Inventario', route: '#', enabled: false },
                        { label: 'Compras', route: '#', enabled: false },
                        { label: 'Historial de compras', route: '#', enabled: false }
                    
                    ]
                },
                {
                    title: 'VENTAS Y CAJA', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M3 6h18M6 6v12"/></svg>',
                    items: [
                        { label: 'Nueva venta', route: '#', enabled: false },
                        { label: 'Historial de ventas', route: '#', enabled: false },
                        { label: 'Recibos', route: '#', enabled: false },
                        { label: 'Descuentos mayoristas', route: '#', enabled: false },
                        { label: 'Cierre de caja', route: '#', enabled: false }
                    ]
                },
                {
                    title: 'ADMINISTRACIÓN', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="3"/></svg>',
                    items: [
                        { label: 'Reportes y estadísticas', route: '#', enabled: false },
                        { label: 'Clientes', route: '#', enabled: false },
                        { label: 'Empleados y roles', route: '#', enabled: false },
                        { label: 'Configuración', route: '#', enabled: false }
                    ]
                }
            ];

            // Renderizar menú a partir de menuData
            function renderMenu() {
                const grid = document.getElementById('mmGrid');
                if (!grid) return;
                grid.innerHTML = '';

                menuData.forEach(group => {
                    const col = document.createElement('div');
                    col.className = 'mm-col';

                    const title = document.createElement('div');
                    title.className = 'mm-col-title';
                    title.setAttribute('tabindex', '0');
                    title.setAttribute('aria-expanded', 'false');
                    title.innerHTML = (group.icon || '') + '<span>' + group.title + '</span>';
                    col.appendChild(title);

                    const hr = document.createElement('hr'); hr.setAttribute('aria-hidden','true'); col.appendChild(hr);

                    const ul = document.createElement('ul'); ul.className = 'mm-list'; ul.setAttribute('role','menu');

                    group.items.forEach(item => {
                        const li = document.createElement('li'); li.setAttribute('role','none');

                        // Si la opción tiene acciones, renderizamos un botón toggle y un sublist
                        if (item.acciones && Array.isArray(item.acciones)) {
                            const btn = document.createElement('button');
                            btn.className = 'mm-item has-actions ' + (item.enabled ? 'enabled' : 'disabled');
                            btn.setAttribute('type','button');
                            btn.setAttribute('aria-expanded','false');
                            btn.setAttribute('role','menuitem');
                            if (!item.enabled) btn.setAttribute('aria-disabled','true');

                            // icon + label
                            const ico = document.createElement('span'); ico.className = 'mm-item-icon'; ico.innerHTML = item.icon || '';
                            btn.appendChild(ico);
                            const lbl = document.createElement('span'); lbl.textContent = item.label; btn.appendChild(lbl);

                            // small chevron
                            const chev = document.createElement('span'); chev.className = 'mm-item-chev'; chev.setAttribute('aria-hidden','true'); chev.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>';
                             btn.appendChild(chev);
                            // crear sublista oculta
                            const sub = document.createElement('ul'); sub.className = 'mm-sublist'; sub.setAttribute('role','menu'); sub.hidden = true;

                            item.acciones.forEach(action => {
                                const sli = document.createElement('li'); sli.setAttribute('role','none');
                                const sa = document.createElement('a'); sa.className = 'mm-subitem'; sa.setAttribute('role','menuitem'); sa.setAttribute('href', action.route); sa.style.fontSize = '13px';
                                sa.innerHTML = '<span class="mm-subitem-icon">' + (action.icon || '') + '</span><span class="mm-subitem-label">' + action.label + '</span>';
                                sli.appendChild(sa);
                                sub.appendChild(sli);
                            });

                            // eventos: abrir/cerrar (solo una abierto a la vez)
                            btn.addEventListener('click', function (e) {
                                e.preventDefault();
                                const open = btn.getAttribute('aria-expanded') === 'true';
                                // cerrar todos
                                document.querySelectorAll('.mm-item.has-actions[aria-expanded="true"]').forEach(function(t){ t.setAttribute('aria-expanded','false'); t.classList.remove('is-open'); const s=t.nextElementSibling; if(s && s.classList.contains('mm-sublist')) s.hidden=true; });
                                if (!open) { btn.setAttribute('aria-expanded','true'); btn.classList.add('is-open'); sub.hidden = false; }
                            });
                            // keyboard: Enter/Space toggle
                            btn.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); btn.click(); } });

                            ul.appendChild(li); li.appendChild(btn); li.appendChild(sub);
                        }
                        else {
                            const a = document.createElement(item.enabled ? 'a' : 'button');
                            a.className = 'mm-item ' + (item.enabled ? 'enabled' : 'disabled');
                            a.setAttribute('role','menuitem');
                            if (item.enabled) { a.setAttribute('href', item.route); }
                            else { a.setAttribute('aria-disabled','true'); a.setAttribute('type','button'); }

                            const ico = document.createElement('span'); ico.className = 'mm-item-icon'; ico.innerHTML = item.icon || '';
                            a.appendChild(ico);
                            const label = document.createElement('span'); label.textContent = item.label; a.appendChild(label);

                            if (!item.enabled) {
                                a.addEventListener('click', (e) => { e.preventDefault(); showToast('Módulo en desarrollo'); });
                            }

                            ul.appendChild(li); li.appendChild(a);
                        }
                    });

                    col.appendChild(ul);
                    grid.appendChild(col);
                });

                // leyenda final: disponible / próximamente
                const panelInner = grid.parentElement;
                if (panelInner) {
                    // eliminar leyenda previa si existe
                    const prev = panelInner.querySelector('.mm-legend'); if (prev) prev.remove();
                    const legend = document.createElement('div'); legend.className = 'mm-legend';
                    legend.innerHTML = '<span class="dot"><span class="marker available"></span> Disponible</span><span class="dot"><span class="marker soon"></span> Próximamente</span>';
                    panelInner.appendChild(legend);
                }
            }

            // Toast simple
            let toastTimeout = null;
            function showToast(msg) {
                let t = document.getElementById('mmToast');
                if (!t) {
                    t = document.createElement('div'); t.id = 'mmToast'; t.className = 'mm-toast'; document.body.appendChild(t);
                }
                t.textContent = msg;
                t.classList.add('show');
                clearTimeout(toastTimeout);
                toastTimeout = setTimeout(() => t.classList.remove('show'), 1800);
            }

            // Interacciones: apertura, cierre, accesibilidad y acordeón móvil
            function initInteractions() {
                const toggle = document.getElementById('menuOpcionesToggle');
                const panel = document.getElementById('menuOpciones');

                function setPanel(open) {
                    if (!panel || !toggle) return;
                    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                    if (open) {
                        panel.hidden = false; panel.setAttribute('aria-hidden','false'); toggle.closest('.fj-menu-item')?.classList.add('is-open');
                        // focus al primer enlace
                        const first = panel.querySelector('.mm-item.enabled'); if (first) first.focus();
                    } else {
                        panel.hidden = true; panel.setAttribute('aria-hidden','true'); toggle.closest('.fj-menu-item')?.classList.remove('is-open');
                        // cerrar acordeón móvil
                        document.querySelectorAll('.mm-col.is-open').forEach(c=>{ c.classList.remove('is-open'); c.querySelector('.mm-col-title')?.setAttribute('aria-expanded','false'); });
                    }
                }

                toggle?.addEventListener('click', () => setPanel(toggle.getAttribute('aria-expanded') !== 'true'));

                // ESC cierra
                document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { setPanel(false); toggle?.focus(); } });

                // click fuera cierra
                document.addEventListener('click', (e) => { if (!panel || !toggle) return; if (!panel.contains(e.target) && !toggle.contains(e.target)) setPanel(false); });

                // acordeón en mobile: toggles
                document.addEventListener('click', (e) => {
                    const t = e.target.closest('.mm-col-title');
                    if (!t) return;
                    const col = t.closest('.mm-col');
                    if (!col) return;
                    const open = col.classList.toggle('is-open');
                    t.setAttribute('aria-expanded', open ? 'true' : 'false');
                });

                // keyboard: abrir con ArrowDown desde toggle
                toggle?.addEventListener('keydown', function (e) {
                    if (e.key === 'ArrowDown') { e.preventDefault(); setPanel(true); }
                });
            }

            // Inicialización al cargar DOM
            document.addEventListener('DOMContentLoaded', function () { renderMenu(); initInteractions(); });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>