<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ferretería Joel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/FERRETERIA__Joel.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        string activo = (string?)ViewData["ActiveMenu"] ?? "";
    }

    <header class="fj-header">
        <div class="fj-header-inner">

            <a class="fj-brand" asp-page="/Index" aria-label="Ir al inicio">
                <span class="fj-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
                </span>
                <span class="fj-brand-name">FERRETERÍA <strong>JOEL</strong></span>
            </a>

            <nav class="fj-nav" id="fjNav" aria-label="Navegación principal">
                <ul class="fj-menu">

                    <li class="fj-menu-item@(activo == "Productos" ? " is-active" : "")">
                        <a class="fj-menu-link" asp-page="/Productos">Productos</a>
                    </li>

                    <li class="fj-menu-item@(activo == "Categorias" ? " is-active" : "")">
                        <a class="fj-menu-link" asp-page="/Categorias">Categorías</a>
                    </li>

                    <li class="fj-menu-item@(activo == "Proveedores" ? " is-active" : "")">
                        <a class="fj-menu-link" asp-page="/Proveedores">Proveedores</a>
                    </li>

                    <li class="fj-menu-item has-mega">
                        <span class="fj-menu-link">
                            Módulos
                            <svg class="fj-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
                        </span>
                        <button type="button" class="fj-mega-toggle" data-fj-mega-toggle aria-label="Abrir submenú de módulos" aria-expanded="false">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                        </button>
                        <section class="fj-mega" aria-label="Próximos módulos del sistema">
                            <div class="fj-mega-shell">
                                <p class="fj-mega-title">Próximos módulos</p>
                                <div class="fj-mega-grid">
                                    <div class="fj-mega-card is-soon">
                                        <span class="fj-mega-ico" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><polyline points="3.27 6.96 12 12.01 20.73 6.96" /><line x1="12" y1="22.08" x2="12" y2="12" /></svg>
                                        </span>
                                        <span class="fj-mega-nombre">Inventario <span class="fj-badge">Próximamente</span></span>
                                        <span class="fj-mega-desc">Control de existencias y movimientos de stock.</span>
                                    </div>
                                    <div class="fj-mega-card is-soon">
                                        <span class="fj-mega-ico" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" /></svg>
                                        </span>
                                        <span class="fj-mega-nombre">Ventas <span class="fj-badge">Próximamente</span></span>
                                        <span class="fj-mega-desc">Emisión de ventas y atención al cliente.</span>
                                    </div>
                                    <div class="fj-mega-card is-soon">
                                        <span class="fj-mega-ico" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 0 1-8 0" /></svg>
                                        </span>
                                        <span class="fj-mega-nombre">Compras <span class="fj-badge">Próximamente</span></span>
                                        <span class="fj-mega-desc">Registro de compras y órdenes de pedido.</span>
                                    </div>
                                    <div class="fj-mega-card is-soon">
                                        <span class="fj-mega-ico" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
                                        </span>
                                        <span class="fj-mega-nombre">Reportes <span class="fj-badge">Próximamente</span></span>
                                        <span class="fj-mega-desc">Indicadores y consultas para la gerencia.</span>
                                    </div>
                                    <div class="fj-mega-card is-soon">
                                        <span class="fj-mega-ico" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                                        </span>
                                        <span class="fj-mega-nombre">Usuarios <span class="fj-badge">Próximamente</span></span>
                                        <span class="fj-mega-desc">Gestión de usuarios y permisos del sistema.</span>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </li>
                </ul>

                <div class="fj-nav-side">
                    <button class="fj-icon-btn" type="button" aria-label="Notificaciones">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                        <span class="fj-dot" aria-hidden="true"></span>
                    </button>
                    <button class="fj-icon-btn" type="button" aria-label="Configuración">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                    </button>
                    <a class="fj-userchip" href="#" aria-label="Perfil de usuario">
                        <span class="fj-userchip-avatar" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        </span>
                        <span class="fj-userchip-name">Admin</span>
                    </a>
                </div>
            </nav>

            <button class="fj-burger" type="button" data-fj-burger aria-label="Abrir menú" aria-expanded="false" aria-controls="fjNav">
                <span class="fj-burger-line"></span>
                <span class="fj-burger-line"></span>
                <span class="fj-burger-line"></span>
            </button>
        </div>
    </header>

    <main class="fj-main">
        @RenderBody()
    </main>

    <footer class="fj-footer">
        <div class="fj-footer-shell">
            <div class="fj-footer-col fj-footer-brandblk">
                <div class="fj-footer-brand">
                    <span class="fj-brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
                    </span>
                    <span class="fj-brand-name">FERRETERÍA <strong>JOEL</strong></span>
                </div>
                <p class="fj-footer-tag">Herramientas y materiales de construcción para cada proyecto.</p>
            </div>

            <div class="fj-footer-col">
                <p class="fj-footer-title">Navegación</p>
                <ul class="fj-footer-list">
                    <li><a asp-page="/Index">Inicio</a></li>
                    <li><a asp-page="/Productos">Productos</a></li>
                    <li><a asp-page="/Categorias">Categorías</a></li>
                    <li><a asp-page="/Proveedores">Proveedores</a></li>
                    <li><span>Inventario</span></li>
                </ul>
            </div>

            <div class="fj-footer-col">
                <p class="fj-footer-title">Contacto</p>
                <ul class="fj-footer-list fj-footer-list-contact">
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                        Av. Central N.º 123, El Alto · La Paz
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                        +591 2 123 4567
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                        contacto@ferreteriajoel.com
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                        Lun – Sáb · 8:00 – 19:00
                    </li>
                </ul>
            </div>

            <div class="fj-footer-col">
                <p class="fj-footer-title">La empresa</p>
                <ul class="fj-footer-list">
                    <li><span>Sobre nosotros</span></li>
                    <li><span>Descuentos por mayor</span></li>
                    <li><span>Política de devoluciones</span></li>
                    <li><span>Trabaja con nosotros</span></li>
                </ul>
            </div>
        </div>
        <div class="fj-footer-bottom">
            <span>© 2026 Ferretería Joel. Todos los derechos reservados.</span>
            <span>Sistema administrativo · Sprint 1</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>