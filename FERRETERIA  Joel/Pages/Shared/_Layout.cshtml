<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ferretería Joel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/FERRETERIA__Joel.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        string activo = (string?)ViewData["ActiveMenu"] ?? "";
    }

    <header class="fj-header">
        <div class="fj-header-inner">

            <a class="fj-brand" asp-page="/Index" aria-label="Ir al inicio">
                <span class="fj-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
                </span>
                <span class="fj-brand-name">FERRETERÍA <strong>JOEL</strong></span>
            </a>

            <nav class="fj-nav" id="fjNav" aria-label="Navegación principal">
                <ul class="fj-menu">

                    <li class="fj-menu-item@(activo == "Home" ? " is-active" : "")">
                        <a class="fj-menu-link" asp-page="/Index">Home</a>
                    </li>

                    <li class="fj-menu-item">
                        <!-- Botón principal que abre el mega menú (sin borde, con chevron que rota) -->
                        <button id="menuOpcionesToggle" class="fj-menu-link mm-toggle" aria-haspopup="true" aria-expanded="false" type="button">
                            <span class="mm-toggle-label">Menú de opciones</span>
                            <svg class="mm-toggle-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="9 6 15 12 9 18" />
                            </svg>
                        </button>

                        <!-- Panel desplegable (estilo moderno, plano) -->
                        <section id="menuOpciones" class="mm-panel" role="menu" aria-label="Menú de opciones" aria-hidden="true" hidden>
                            <div class="mm-grid">
                                <!-- PRODUCTOS -->
                                <div class="mm-col" data-section="productos">
                                    <div class="mm-title" tabindex="0" aria-expanded="false">PRODUCTOS</div>
                                    <hr class="mm-sep" />
                                    <ul class="mm-list" role="menu">
                                        <li role="none"><a role="menuitem" class="mm-link" asp-page="/Productos/Create"><span class="mm-ico">＋</span> Crear producto</a></li>
                                        <li role="none"><a role="menuitem" class="mm-link" asp-page="/Productos/Edit"><span class="mm-ico">✎</span> Editar producto</a></li>
                                        <li role="none"><a role="menuitem" class="mm-link" asp-page="/Productos"><span class="mm-ico">📋</span> Mostrar productos</a></li>
                                        <li role="none"><a role="menuitem" class="mm-link mm-link-destructive" asp-page="/Productos/Delete"><span class="mm-ico">🗑</span> Eliminar producto</a></li>
                                    </ul>
                                </div>

                                <!-- CATEGORÍAS -->
                                <div class="mm-col" data-section="categorias">
                                    <div class="mm-title" tabindex="0" aria-expanded="false">CATEGORÍAS</div>
                                    <hr class="mm-sep" />
                                    <ul class="mm-list" role="menu">
                                        <li role="none"><a role="menuitem" class="mm-link" asp-page="/Categorias/Create"><span class="mm-ico">＋</span> Crear categoría</a></li>
                                        <li role="none"><a role="menuitem" class="mm-link" asp-page="/Categorias/Edit"><span class="mm-ico">✎</span> Editar categoría</a></li>
                                        <li role="none"><a role="menuitem" class="mm-link" asp-page="/Categorias"><span class="mm-ico">📋</span> Mostrar categorías</a></li>
                                        <li role="none"><a role="menuitem" class="mm-link mm-link-destructive" asp-page="/Categorias/Delete"><span class="mm-ico">🗑</span> Eliminar categoría</a></li>
                                    </ul>
                                </div>

                                <!-- PROVEEDORES -->
                                <div class="mm-col" data-section="proveedores">
                                    <div class="mm-title" tabindex="0" aria-expanded="false">PROVEEDORES</div>
                                    <hr class="mm-sep" />
                                    <ul class="mm-list" role="menu">
                                        <li role="none"><a role="menuitem" class="mm-link" asp-page="/Proveedores/Create"><span class="mm-ico">＋</span> Crear proveedor</a></li>
                                        <li role="none"><a role="menuitem" class="mm-link" asp-page="/Proveedores/Edit"><span class="mm-ico">✎</span> Editar proveedor</a></li>
                                        <li role="none"><a role="menuitem" class="mm-link" asp-page="/Proveedores"><span class="mm-ico">📋</span> Mostrar proveedores</a></li>
                                        <li role="none"><a role="menuitem" class="mm-link mm-link-destructive" asp-page="/Proveedores/Delete"><span class="mm-ico">🗑</span> Eliminar proveedor</a></li>
                                    </ul>
                                </div>
                            </div>
                        </section>
                    </li>
                </ul>

                <div class="fj-nav-side">
                    <button class="fj-icon-btn" type="button" aria-label="Notificaciones">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                        <span class="fj-dot" aria-hidden="true"></span>
                    </button>
                    <button class="fj-icon-btn" type="button" aria-label="Configuración">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                    </button>
                    <a class="fj-userchip" href="#" aria-label="Perfil de usuario">
                        <span class="fj-userchip-avatar" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        </span>
                        <span class="fj-userchip-name">Admin</span>
                    </a>
                </div>
            </nav>

            <button class="fj-burger" type="button" data-fj-burger aria-label="Abrir menú" aria-expanded="false" aria-controls="fjNav">
                <span class="fj-burger-line"></span>
                <span class="fj-burger-line"></span>
                <span class="fj-burger-line"></span>
            </button>
        </div>
    </header>

    <main class="fj-main">
        @RenderBody()
    </main>

    <footer class="fj-footer">
        <div class="fj-footer-shell">
            <div class="fj-footer-col fj-footer-brandblk">
                <div class="fj-footer-brand">
                    <span class="fj-brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
                    </span>
                    <span class="fj-brand-name">FERRETERÍA <strong>JOEL</strong></span>
                </div>
                <p class="fj-footer-tag">Herramientas y materiales de construcción para cada proyecto.</p>
            </div>

            <div class="fj-footer-col">
                <p class="fj-footer-title">Navegación</p>
                <ul class="fj-footer-list">
                    <li><a asp-page="/Index">Inicio</a></li>
                    <li><a asp-page="/Productos">Productos</a></li>
                    <li><a asp-page="/Categorias">Categorías</a></li>
                    <li><a asp-page="/Proveedores">Proveedores</a></li>
                    <li><span>Inventario</span></li>
                </ul>
            </div>

            <div class="fj-footer-col">
                <p class="fj-footer-title">Contacto</p>
                <ul class="fj-footer-list fj-footer-list-contact">
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                        Av. Central N.º 123, El Alto · La Paz
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                        +591 2 123 4567
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                        contacto@ferreteriajoel.com
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                        Lun – Sáb · 8:00 – 19:00
                    </li>
                </ul>
            </div>

            <div class="fj-footer-col">
                <p class="fj-footer-title">La empresa</p>
                <ul class="fj-footer-list">
                    <li><span>Sobre nosotros</span></li>
                    <li><span>Descuentos por mayor</span></li>
                    <li><span>Política de devoluciones</span></li>
                    <li><span>Trabaja con nosotros</span></li>
                </ul>
            </div>
        </div>
        <div class="fj-footer-bottom">
            <span>© 2026 Ferretería Joel. Todos los derechos reservados.</span>
            <span>Sistema administrativo · Sprint 1</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        /* Mega menú moderno: apertura, cierre, accesibilidad y acordeón en móvil */
        (function () {
            var toggle = document.getElementById('menuOpcionesToggle');
            var panel = document.getElementById('menuOpciones');

            function setPanel(open) {
                if (!panel || !toggle) return;
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                if (open) {
                    panel.hidden = false;
                    panel.setAttribute('aria-hidden', 'false');
                    toggle.closest('.fj-menu-item')?.classList.add('is-open');
                } else {
                    panel.hidden = true;
                    panel.setAttribute('aria-hidden', 'true');
                    toggle.closest('.fj-menu-item')?.classList.remove('is-open');
                    // cerrar secciones internas en móvil
                    document.querySelectorAll('.mm-col.is-open').forEach(function (c) {
                        c.classList.remove('is-open');
                        var t = c.querySelector('.mm-title');
                        if (t) t.setAttribute('aria-expanded', 'false');
                    });
                }
            }

            if (panel) { panel.hidden = true; panel.setAttribute('aria-hidden', 'true'); }

            toggle?.addEventListener('click', function () { setPanel(toggle.getAttribute('aria-expanded') !== 'true'); });

            // cerrar con ESC
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { setPanel(false); toggle?.focus(); } });

            // click fuera cierra
            document.addEventListener('click', function (e) {
                if (!panel || !toggle) return;
                if (!panel.contains(e.target) && !toggle.contains(e.target)) setPanel(false);
            });

            // acordeón móvil: toggle en cada título
            document.querySelectorAll('.mm-title').forEach(function (title) {
                title.addEventListener('click', function () {
                    var col = title.closest('.mm-col');
                    if (!col) return;
                    var open = col.classList.toggle('is-open');
                    title.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
                title.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); title.click(); } });
            });

            // focus inicial al abrir con ArrowDown
            toggle?.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowDown' && panel && !panel.hidden) {
                    var first = panel.querySelector('.mm-link');
                    first?.focus();
                    e.preventDefault();
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>