@* Modal de confirmación reutilizable para acciones sensibles (desactivar, eliminar, etc.).
   Controlado por wwwroot/js/site.js mediante el atributo data-fj-confirm en los <form>. *@
<div class="fj-modal" id="fjConfirmModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="fjConfirmTitle">
    <div class="fj-modal-backdrop" data-fj-modal-close aria-hidden="true"></div>
    <div class="fj-modal-wrapper" role="document">
        <div class="fj-modal-dialog">
            <div class="fj-modal-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
            </div>
            <h2 class="fj-modal-title" id="fjConfirmTitle">Confirmar acción</h2>
            <p class="fj-modal-message" id="fjConfirmMessage"></p>
            <div class="fj-modal-actions">
                <button type="button" class="fj-btn fj-btn-ghost" data-fj-modal-close>Cancelar</button>
                <button type="button" class="fj-btn fj-btn-danger" id="fjConfirmOk">Confirmar</button>
            </div>
        </div>
    </div>
</div>