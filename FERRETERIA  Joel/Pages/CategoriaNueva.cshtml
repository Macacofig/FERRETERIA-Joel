@page
@model FERRETERIA__Joel.Pages.CategoriaNuevaModel
@{
    ViewData["Title"] = "Nueva Categoría";
    ViewData["ActiveMenu"] = "Categorias";
}
@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true" />
}

<div class="fj-container fj-page-products">

    <section class="fj-page-head">
        <p class="fj-eyebrow">Módulo · Catálogo</p>
        <h1>Nueva Categoría</h1>
        <p class="fj-page-sub">Registra una nueva familia de productos.</p>
    </section>

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="fj-alert" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
            <span>@Model.MensajeError</span>
        </div>
    }

    <form method="post" class="fj-card fj-form">
        <div class="fj-form-grid">
            <div class="fj-form-field">
                <label class="fj-form-label" asp-for="NuevaCategoria.Codigo">Código</label>
                <input class="fj-input" asp-for="NuevaCategoria.Codigo" maxlength="20" placeholder="Ej: CAT-011" required />
            </div>

            <div class="fj-form-field">
                <label class="fj-form-label" asp-for="NuevaCategoria.Nombre">Nombre de la Categoría</label>
                <input class="fj-input" asp-for="NuevaCategoria.Nombre" maxlength="100" placeholder="Ej: Cerrajería" required />
            </div>

            <div class="fj-form-field fj-form-field--full">
                <label class="fj-form-label" asp-for="NuevaCategoria.Descripcion">Descripción</label>
                <textarea class="fj-input fj-input-area" asp-for="NuevaCategoria.Descripcion" rows="3" maxlength="255" placeholder="Detalle opcional de la categoría..."></textarea>
            </div>

            <div class="fj-form-field fj-form-field--full">
                <label class="fj-form-label" asp-for="NuevaCategoria.IdEmpleadoResponsable">Empleado responsable</label>
                <select class="fj-input fj-select" asp-for="NuevaCategoria.IdEmpleadoResponsable">
                    <option value="">-- Seleccione --</option>
                    @foreach (var empleado in Model.Empleados)
                    {
                        <option value="@empleado.IdEmpleado">@empleado.Nombre</option>
                    }
                </select>
            </div>

            <div class="fj-form-field fj-form-field--full">
                <label class="fj-form-label" asp-for="NuevaCategoria.Estado">Estado</label>
                <select class="fj-input fj-select" asp-for="NuevaCategoria.Estado">
                    <option value="1">Activo</option>
                    <option value="0">Inactivo</option>
                </select>
            </div>
        </div>

        <div class="fj-form-actions">
            <a asp-page="Categorias" class="fj-btn fj-btn-ghost">Cancelar</a>
            <button type="submit" class="fj-btn fj-btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" /></svg>
                Guardar
            </button>
        </div>
    </form>

</div>